{
  "name": "transjakarta-playwright-pom",
  "version": "1.0.0",
  "description": "Technical Test - Playwright Automation dengan Page Object Model (PT Transportasi Jakarta)",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright test",
    "test:webtables": "playwright test tests/webTables.spec.ts --headed",
    "test:droppable": "playwright test tests/droppable.spec.ts --headed",
    "test:resizable": "playwright test tests/resizable.spec.ts --headed",
    "test:form": "playwright test tests/practiceForm.spec.ts --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "csv-parse": "^5.5.6",
    "typescript": "^5.6.0"
  }
